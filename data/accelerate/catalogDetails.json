      "destinations": "Microsoft Fabric",
      "destinationsDetail": "Lakehouse + Direct Lake",
      "extraction": "CRESTONE Move · delta por cambio",
      "reportingCurrency": "USD + moneda local"
    },
    "reports": [
      "Resumen ejecutivo de ventas",
      "Pedidos abiertos y backlog",
      "Cumplimiento de entregas (OTIF)",
      "Facturación y margen"
    ],
