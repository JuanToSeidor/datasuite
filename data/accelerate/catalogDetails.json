      {
        "title": "Ventas facturadas",
        "description": "Por cliente, material, org. de ventas y canal"
      },
      {
        "title": "Backlog de pedidos",
        "description": "Pedidos abiertos, sin entregar y sin facturar"
      },
      {
        "title": "Cumplimiento de entregas",
        "description": "OTIF y días de atraso contra fecha comprometida"
      },
      {
        "title": "Margen bruto",
        "description": "Ingreso neto menos costo de la factura"
      }
    ],
